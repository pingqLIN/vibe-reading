{
  "manifest_version": 3,
  "name": "氛圍閱讀 Vibe Reading",
  "version": "1.5.0",
  "description": "使用 Chrome 內建 AI 翻譯 PDF 與一般網頁：支援 Translator API／Gemini Nano 混合路由、專業辭庫與 Prompt Diff Lab；AI 推理在地端執行",
  "permissions": ["activeTab", "tabs", "storage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["translate-core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "氛圍閱讀 Vibe Reading（點擊開啟翻譯檢視器）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "translate-pdf": {
      "suggested_key": { "default": "Alt+T", "mac": "Alt+T" },
      "description": "用氛圍閱讀翻譯目前分頁（PDF 開檢視器，網頁就地翻譯）"
    }
  }
}
